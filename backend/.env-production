ENVIRONMENT=prod
APP_TITLE=Finance API
PUBLIC_BASE_URL=https://finance.fibboo.dev/api
ALLOWED_REDIRECT_URIS=["https://finance.fibboo.dev/auth/callback", "https://finance.fibboo.dev/auth/link-callback"]
ALLOWED_ORIGINS=["https://finance.fibboo.dev"]
JWT_SECRET='${JWT_SECRET}'
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=2592000

DATABASE_URL='postgresql+asyncpg://finance:${POSTGRES_PASSWORD}@postgres:5432/finance'

TELEGRAM_CLIENT_ID='${TELEGRAM_CLIENT_ID}'
TELEGRAM_CLIENT_SECRET='${TELEGRAM_CLIENT_SECRET}'
TELEGRAM_SERVER_METADATA_URL=https://oauth.telegram.org/.well-known/openid-configuration

GOOGLE_CLIENT_ID='${GOOGLE_CLIENT_ID}'
GOOGLE_CLIENT_SECRET='${GOOGLE_CLIENT_SECRET}'
GOOGLE_SERVER_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration

EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest/USD
EXCHANGE_RATES_CACHE_SECONDS=43200
