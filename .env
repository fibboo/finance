ENVIRONMENT=local
APP_TITLE=Finance API
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_REDIRECT_URIS=["http://localhost:3000/auth/callback", "finance://auth/callback"]
JWT_SECRET=local_jwt_secret_of_at_least_32_bytes
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=2592000
MAX_ACCOUNTS_PER_USER=10

DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/finance

TELEGRAM_CLIENT_ID=123456789
TELEGRAM_CLIENT_SECRET=fake_telegram_client_secret
